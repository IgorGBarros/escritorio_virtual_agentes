# .env.example
# === Vault ===
VAULT_PATH=./AI-Office-Vault
VAULT_SYNC_MODE=local

# === GitHub (obrigatório para git_service) ===
GITHUB_OWNER=seu-usuario
GITHUB_REPO=seu-repo-ai-office
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx

# === LLM ===
LLM_PROVIDER=openai
#LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
#LLM_MODEL=gpt-4o-mini

# === Server ===
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000"]

# === Logging ===
LOG_LEVEL=INFO